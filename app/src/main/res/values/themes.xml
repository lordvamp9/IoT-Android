<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme en tono claro moderno -->
    <style name="Base.Theme.IoTClimaRiego" parent="Theme.Material3.Light.NoActionBar">
        <!-- Colores Principales -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="android:colorBackground">@color/bg_app</item>

        <!-- Barra de estado y navegación en tono claro -->
        <item name="android:statusBarColor">@color/bg_app</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/bg_app</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.IoTClimaRiego" parent="Base.Theme.IoTClimaRiego" />
</resources>